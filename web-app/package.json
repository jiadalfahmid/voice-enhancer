{
  "name": "voice-enhancer-web",
  "private": true,
  "version": "0.0.1",
  "description": "Professional on-device AI speech enhancement studio running 100% in the browser",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "postinstall": "node scripts/copy-ort.mjs",
    "test:studio": "node --experimental-strip-types --test tests/studio/*.nodetest.ts tests/studio/*.nodetest.js",
    "typecheck:studio": "tsc -p tsconfig.studio.json",
    "check": "npm run typecheck:studio && npm test && npm run test:studio"
  },
  "dependencies": {
    "@breezystack/lamejs": "1.2.7",
    "onnxruntime-web": "1.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "^5.6.0",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
